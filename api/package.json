{
  "name": "ns-workforce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 test/integration/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "specs:coverage": "node scripts/spec-coverage.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "twilio": "6.2.0",
    "zod": "^4.6.7"
  }
}
