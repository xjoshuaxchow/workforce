HOST=127.0.0.1
PORT=8310
AMS_ORIGIN=http://127.0.0.1:5210
DATABASE_URL=postgresql://workforce_local:replace-me@127.0.0.1:5432/workforce_local
TEST_DATABASE_URL=postgresql://workforce_local:replace-me@127.0.0.1:5432/workforce_test
SEED_ADMIN_EMAIL=admin@workforce.local
SEED_ADMIN_PASSWORD=replace-with-a-long-local-password
MESSAGING_MODE=mock
MESSAGING_SECRET=replace-with-a-random-secret

# Only used when MESSAGING_MODE=twilio-pstn. Keep real credentials in ignored .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PUBLIC_BASE_URL=

# WhatsApp is independent of the PSTN mode. Keep the default mock.
WHATSAPP_MODE=mock
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_API_KEY=
# Copy the example and replace names/order with approved Meta templates before enabling.
WHATSAPP_TEMPLATES_FILE=./config/whatsapp-templates.example.json

# Optional: base64-encoded 32-byte settings encryption key.
# Otherwise the first local startup creates .local/settings.key (keep it with DB backups).
# Provider values above bootstrap only; after that use the AMS channel settings page.
WORKFORCE_SETTINGS_KEY=
